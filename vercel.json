{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data: blob: https:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https:;"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/roblox-users/(.*)",
      "destination": "https://users.roblox.com/$1"
    },
    {
      "source": "/roblox-thumbnails/(.*)",
      "destination": "https://thumbnails.roblox.com/$1"
    },
    {
      "source": "/roblox-avatar-api/(.*)",
      "destination": "https://avatar.roblox.com/$1"
    },
    {
      "source": "/mlbb-check/(.*)",
      "destination": "https://www.smile.one/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}